@page "/students"
@rendermode InteractiveServer
@implements IDisposable
@inject SchedulingService Scheduler
@using AcademicScheduler.Services

<PageTitle>Student List</PageTitle>

<h1>Student List</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Year Level</th>
            <th>Completed Courses</th>
            <th>Current Credit Load</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Scheduler.Students)
        {
            <tr>
                <td>@student.Name</td>
                <td>@student.YearLevel</td>
                <td>@string.Join(", ", student.CompletedCoursesRaw.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))</td>
                <td>@student.CurrentCreditLoad</td>
            </tr>
        }
    </tbody>
</table>

@code {
    protected override void OnInitialized()
    {
        Scheduler.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Scheduler.OnStateChanged -= StateHasChanged;
    }
}
